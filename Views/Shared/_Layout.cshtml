<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Hotel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
<nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">Hotel</a>
        <div class="navbar-nav">
            <a class="nav-link" asp-controller="Habitaciones" asp-action="Index">Habitaciones</a>
            <a class="nav-link" asp-controller="Huespedes" asp-action="Index">Huéspedes</a>
            <a class="nav-link" asp-controller="Reservas" asp-action="Index">Reservas</a>
        </div>
    </div>
</nav>
<main class="container">
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    @RenderBody()
</main>
</body>
</html>
