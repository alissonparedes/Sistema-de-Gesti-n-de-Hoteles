@model Reserva
@{ ViewData["Title"] = "Nueva reserva"; }
<h2>Nueva reserva</h2>
<form asp-action="Create" method="post" style="max-width:480px">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="HuespedId" class="form-label"></label><select asp-for="HuespedId" class="form-select" asp-items="(SelectList)ViewBag.Huespedes"></select></div>
    <div class="mb-3"><label asp-for="HabitacionId" class="form-label"></label><select asp-for="HabitacionId" class="form-select" asp-items="(SelectList)ViewBag.Habitaciones"></select></div>
    <div class="mb-3"><label asp-for="FechaEntrada" class="form-label"></label><input asp-for="FechaEntrada" type="date" class="form-control" /></div>
    <div class="mb-3"><label asp-for="FechaSalida" class="form-label"></label><input asp-for="FechaSalida" type="date" class="form-control" /></div>
    <button class="btn btn-success">Reservar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
